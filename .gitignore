# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated output (built static site — served by Caddy, regenerated by generate.py)
output/

# SQLite database (regenerated by ingest_careful.py; WAL/SHM are runtime artifacts)
data/*.db
data/*.db-shm
data/*.db-wal

# Cached last fetch (so a failed write can be retried without re-fetching)
data/last_fetch.json.gz
data/last_fetch.json.gz.tmp

# Local misc
.DS_Store
*.log
